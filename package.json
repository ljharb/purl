{
	"name": "purl",
	"version": "2.2.1",
	"description": "a PURL ( https://tc54.org/purl/ ) parser and serializer",
	"main": "./index.mjs",
	"exports": {
		".": "./index.mjs",
		"./parse": "./parse.mjs",
		"./stringify": "./stringify.mjs",
		"./normalize": "./normalize.mjs",
		"./valid": "./valid.mjs",
		"./type": "./type.mjs",
		"./namespace": "./namespace.mjs",
		"./name": "./name.mjs",
		"./version": "./version.mjs",
		"./qualifiers": "./qualifiers.mjs",
		"./subpath": "./subpath.mjs",
		"./eq": "./eq.mjs",
		"./compare": "./compare.mjs",
		"./from-npm": "./from-npm.mjs",
		"./native-name": "./native-name.mjs",
		"./purl": "./purl.mjs",
		"./url": "./url.mjs",
		"./validate": "./validate.mjs",
		"./types": "./types.mjs",
		"./package.json": "./package.json"
	},
	"bin": "./bin.mjs",
	"scripts": {
		"prepack": "git submodule update --init --recursive && npmignore --auto --commentLines=autogenerated",
		"prepublish": "not-in-publish || npm run prepublishOnly",
		"prepublishOnly": "safe-publish-latest",
		"prelint": "git submodule update --init --recursive && evalmd --eslint -b README.md",
		"lint": "eslint .",
		"postlint": "tsc && attw -P",
		"pretest": "npm run lint",
		"pretests-only": "git submodule update --init --recursive",
		"tests-only": "c8 tape 'test/**/*.mjs'",
		"test": "npm run tests-only",
		"posttest": "npx npm@'>= 10.2' audit --production",
		"version": "auto-changelog && git add CHANGELOG.md",
		"postversion": "auto-changelog && git add CHANGELOG.md && git commit --no-edit --amend && git tag -f \"v$(node -e \"console.log(require('./package.json').version)\")\"",
		"dependencies": "node -p \"process.env.npm_command\" | npx \"dt-clean@^1.2.2\" --auto"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ljharb/purl.git"
	},
	"keywords": [
		"purl",
		"package url",
		"package",
		"url",
		"ecma-427"
	],
	"author": "Jordan Harband <ljharb@gmail.com>",
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/ljharb/purl/issues"
	},
	"homepage": "https://github.com/ljharb/purl#readme",
	"dependencies": {
		"npm-package-arg": "^13.0.2",
		"pargs": "^1.7.0",
		"validate-npm-package-name": "^7.0.2"
	},
	"devDependencies": {
		"@arethetypeswrong/cli": "^0.18.5",
		"@ljharb/eslint-config": "^22.2.5",
		"@ljharb/tsconfig": "^0.3.2",
		"@types/node": "^22.20.5",
		"@types/npm-package-arg": "^6.1.4",
		"auto-changelog": "^2.7.0",
		"c8": "^12.0.0",
		"eslint": "^10.12.0",
		"evalmd": "^0.1.0",
		"in-publish": "^2.0.1",
		"npmignore": "^0.3.6",
		"purl": "file:.",
		"safe-publish-latest": "^2.0.0",
		"tape": "^5.10.3",
		"typescript": "next"
	},
	"engines": {
		"node": "^22.21 || ^24.11 || >= 25.2"
	},
	"auto-changelog": {
		"output": "CHANGELOG.md",
		"template": "keepachangelog",
		"unreleased": false,
		"commitLimit": false,
		"backfillLimit": false,
		"hideCredit": true
	},
	"publishConfig": {
		"ignore": [
			".github/workflows",
			".gitmodules",
			"test",
			".attw.json",
			"eslint.config.mjs",
			"types/",
			"vendor/package-url/**",
			"vendor/purl-spec/**",
			"!vendor/purl-spec/purl-types.json"
		]
	}
}
